# Copy to .env and edit. docker compose picks .env up automatically.



# Database
POSTGRES_USER=nobeyama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nobeyama
# Connection string for `mao-45m subref control --database`, read with
# `uv run --env-file monitor/.env`. Use the same user, password and
# database name as above.
MAO_DATABASE_URL=postgresql://nobeyama:change-me@127.0.0.1:5432/nobeyama

# Grafana admin password (user name is admin)
GRAFANA_PASSWORD=change-me

# Port of Grafana on this PC (change it if 3000 is already taken)
GRAFANA_PORT=3000

