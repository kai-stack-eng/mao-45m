# Copy to .env and edit. docker compose picks .env up automatically.

# COSMOS server. Use host.docker.internal to reach a mock running on
# this machine; use the real IP address at the telescope.
COSMOS_HOST=host.docker.internal
COSMOS_PORT=11111

# Seconds between polls. Faster than the source updates is fine:
# duplicate rows are dropped by the primary key on time.
POLL_INTERVAL=1.0

# Database
POSTGRES_USER=nobeyama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nobeyama

# Grafana admin password (user name is admin)
GRAFANA_PASSWORD=change-me

LOG_LEVEL=INFO
