          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- $shift = on: move the latest run's VDIF time to now (replay tests only)\nWITH s AS (\n  SELECT CASE WHEN '$shift' = 'on'\n    THEN (SELECT now() - max(time) FROM control\n          WHERE cosmos_time = (SELECT max(cosmos_time) FROM control))\n    ELSE interval '0' END AS d\n)\nSELECT c.time + s.d AS time,\n  c.epl_c * 1e3 AS \"C\", c.epl_t * 1e3 AS \"T\", c.epl_r * 1e3 AS \"R\",\n  c.epl_b * 1e3 AS \"B\", c.epl_l * 1e3 AS \"L\"\nFROM control c, s\nWHERE ('$shift' = 'off' AND $__timeFilter(c.time))\n   OR ('$shift' = 'on' AND c.time + s.d BETWEEN $__timeFrom() AND $__timeTo())\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "EPL",
      "type": "timeseries"
    },
